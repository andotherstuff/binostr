; CDDL profile for Nostr events encoded with CBOR (RFC 8949).
;
; Cryptographic fields are byte strings. In the packed and integer-keyed
; profiles, a tag value is either ordinary text or the decoded bytes of a
; lowercase, even-length hexadecimal NIP-01 string. A decoder converts tag byte
; strings back to lowercase hexadecimal text. Uppercase and short
; hexadecimal-looking strings remain text so the transform is reversible. The
; schemaless implementation currently emits text tag values only.

; ============================================
; Option A: Schemaless (JSON-like with field names)
; ============================================
nostr-event-schemaless = {
  "id": bstr .size 32,
  "pubkey": bstr .size 32,
  "created_at": int,
  "kind": uint,
  "tags": [* tag],
  "content": tstr,
  "sig": bstr .size 64
}

; ============================================
; Option B: Packed Array (positional, smallest)
; ============================================
; Position: [id, pubkey, created_at, kind, tags, content, sig]
nostr-event-packed = [
  bstr .size 32,    ; 0: id
  bstr .size 32,    ; 1: pubkey
  int,              ; 2: created_at
  uint,             ; 3: kind
  [* tag],          ; 4: tags
  tstr,             ; 5: content
  bstr .size 64     ; 6: sig
]

; ============================================
; Option C: Integer-keyed Map (balance of size and extensibility)
; ============================================
nostr-event-intkey = {
  0: bstr .size 32,   ; id
  1: bstr .size 32,   ; pubkey
  2: int,             ; created_at
  3: uint,            ; kind
  4: [* tag],         ; tags
  5: tstr,            ; content
  6: bstr .size 64    ; sig
}

; ============================================
; Common definitions
; ============================================
tag-value = tstr / bstr
tag = [* tag-value]

; Batch of events
event-batch-packed = [* nostr-event-packed]
event-batch-intkey = [* nostr-event-intkey]
